ALGORITHM: Simulasi Difusi Panas 1D

IMPORT library NumPy dan Matplotlib

DEFINE fungsi s(t)
	RETURN 323
END DEFINE

DEFINE fungsi dsdt(t)
	RETURN 0
END DEFINE

DEFINE fungsi g(t)
	RETURN 0
END DEFINE

INITIAL parameter spasial:
	L <- 0.5
	dx <- 0.01
	Nx <- INTEGER(L / dx)
	beta <- 8.2 x 10^-5

INITIALIZE array temperatur:
	CREATE array u dengan ukuran Nx
	SET seluruh elemen u menjadi:
		s(0) x EXP(-(LINSPACE(0, L, Nx))^2)
	
	u_old <- u

INITIALIZE parameter waktu:
	t <- 0
	dt <- 0.01
	tf <- 100

SET plot_every <- 80

WHILE t < tf DO
	a. Kondisi batas kiri:
		u[0] <- u_old[0] + dsdt(t) x dt
	b. Perhitungan titik interior:
		FOR i <- 1 TO Nx - 1 DO
			u[i] <- u_old[i] + beta / dx^2 x (u_old [i+1] - 2 x u_old[i] + u_old[i-1]) + g(t)
		END FOR
	c. Kondisi batas kanan:
		u[Nx-1] <- u_old[Nx-1] + 2 x beta / dx^2 x (u_old[Nx-2] - u_old[Nx-1]) + g(t)
	d. Perbarui waktu:
		t <- t + dt
	e. Perbarui temperatur sebelumnya:
		u_old <- u
END WHILE

VISUALISASI:
	PLOT u
	SET label grafik = "t = " + STRING(t)
	DISPLAY legend
	DISPLAY plot

END ALGORITHM
