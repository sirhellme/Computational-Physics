ALGORITHM: Simulasi Difusi Panas 1D (Setelah Debug)

CATATAN PERBAIKAN:
1. Suku difusi pada titik interior dan batas kanan harus dikali dt.
2. Suku sumber g(t) juga harus dikali dt.
3. Nx harus INTEGER(L/dx) + 1 agar jarak antar titik tepat sama dengan dx.
4. u_old harus SALINAN u (deep copy), bukan alias/referensi.
5. plot_every harus benar-benar dipakai di dalam loop.
6. Plot harus berada di dalam loop agar beberapa waktu bisa ditampilkan.
7. Waktu dihitung dari indeks langkah (t <- n * dt) agar tidak menumpuk error pembulatan.
8. Kondisi batas kiri langsung memakai s(t), sehingga fungsi dsdt(t) tidak diperlukan lagi.

IMPORT library NumPy dan Matplotlib

DEFINE fungsi s(t)
	RETURN 323
END DEFINE

DEFINE fungsi dsdt(t)
	RETURN 0
END DEFINE

DEFINE fungsi g(t)
	RETURN 0
END DEFINE

INITIAL parameter spasial:
	L <- 0.5
	dx <- 0.01
	Nx <- INTEGER(L / dx) + 1
	beta <- 8.2 x 10^-5
	x <- LINSPACE(0, L, Nx)

INITIALIZE array temperatur:
	CREATE array u dengan ukuran Nx
	SET seluruh elemen u secara element-wise menjadi:
		u <- s(0) x EXP(-(x^2))

	u_old <- COPY(u)

INITIALIZE parameter waktu:
	t <- 0
	dt <- 0.01
	tf <- 100
	Nt <- INTEGER(tf / dt)

	# Syarat stabilitas skema eksplisit: dt <= dx^2 / (2 x beta)
	IF dt > dx^2 / (2 x beta) THEN
		DISPLAY "dt tidak stabil, perkecil dt"
		STOP
	END IF

SET plot_every <- 80

INITIALIZE plot:
	CREATE figure
	SET judul grafik = "Simulasi Difusi Panas 1D"

INITIALIZE penghitung langkah:
	n <- 0

WHILE n <= Nt DO
	t <- n x dt

	# Tampilkan kondisi temperatur pada waktu t
	IF (n MOD plot_every = 0) OR (n = Nt) THEN
		PLOT x, u PADA figure yang sama
		SET label kurva = "t = " + STRING(t)
	END IF

	IF n = Nt THEN
		BREAK
	END IF

	# Hitung u pada waktu t + dt berdasarkan u_old
	# a. Kondisi batas kiri (Dirichlet):
		u[0] <- s(t + dt)

	# b. Perhitungan titik interior:
		FOR i <- 1 TO Nx - 2 DO
			u[i] <- u_old[i]
				+ (beta x dt / dx^2) x (u_old[i+1] - 2 x u_old[i] + u_old[i-1])
				+ g(t) x dt
		END FOR

	# c. Kondisi batas kanan (Neumann / adiabatik):
		u[Nx-1] <- u_old[Nx-1]
			+ (2 x beta x dt / dx^2) x (u_old[Nx-2] - u_old[Nx-1])
			+ g(t) x dt

	# d. Perbarui temperatur sebelumnya dengan salinan u yang baru:
		u_old <- COPY(u)

	# e. Perbarui penghitung langkah:
		n <- n + 1
END WHILE

VISUALISASI:
	SET label sumbu-x = "Posisi x (m)"
	SET label sumbu-y = "Temperatur u (K)"
	SET judul grafik = "Simulasi Difusi Panas 1D"
	DISPLAY legend
	DISPLAY grid
	DISPLAY plot

END ALGORITHM
